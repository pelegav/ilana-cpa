# Copy to .env and fill in real values. Never commit .env.

# Use Supabase's Session Pooler (not Direct connection, which is IPv6-only and
# may be unreachable from some networks/Docker; not the Transaction pooler,
# which breaks Flyway/Hibernate's session-level assumptions).
DB_URL=jdbc:postgresql://aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=8082
