# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root — patterns apply under both frontend/ and backend/.

# --- frontend (Next.js) ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.vercel

# --- backend (Spring Boot / Maven) ---
target/
*.class
.mvn/wrapper/maven-wrapper.jar
HELP.md

# --- env files (can opt-in for committing if needed) ---
.env*
!.env.local.example
!.env.example

# --- misc ---
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
